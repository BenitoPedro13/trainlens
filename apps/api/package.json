{
  "name": "@trainlens/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "concurrently -n api,board -c blue,magenta \"nest start --watch\" \"node --import tsx src/bull-board.server.ts\"",
    "dev:board": "node --import tsx src/bull-board.server.ts",
    "start:local": "dotenv -e ../../.env -- node dist/main",
    "start": "node dist/main",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts --passWithNoTests",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/terminus": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "@sentry/nestjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@trainlens/database": "workspace:*",
    "@trainlens/shared": "workspace:*",
    "bullmq": "^5.76.10",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "testcontainers": "^10.13.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.2",
    "typescript": "^5.5.0"
  }
}
